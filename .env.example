# Copy this file to .env and fill in what you need - `ajp-init`/`ajp-run`/`ajp-api`/tools/dev_up.py all
# work with NONE of these set (embedded Postgres, a local raw store, no optional API keys). Every var here
# is optional; nothing in this file is a secret that ships with the repo, and none of these are read by the
# web/ frontend (it only ever talks to the API over HTTP - see web/.env.local.example for that side).
#
# This list is generated from what the code actually reads (grep -rn "os.environ.get" src/ajp/) - never
# extended with a name no code path uses yet (D6: no fabricated configuration).

# ---------------------------------------------------------------- identification (do this first) -------------
# Shown in every outbound request's User-Agent, so a site operator who wants to reach us about our crawling
# has a real address - until set, requests carry a placeholder ("contact-not-configured@example.invalid").
# See pm/outbox/operator_actions.md item 0.
AJP_CONTACT_EMAIL=

# ---------------------------------------------------------------- database --------------------------------
# ajp-init/tools/dev_up.py never need this - they run their own embedded Postgres. Set DATABASE_URL only to
# point ajp.migrate/ajp.fx (or a production deployment, not built in this milestone) at an EXTERNAL Postgres
# instead. AJP_DSN is the API's own var (ajp.api.deps); it falls back to DATABASE_URL if unset, and ajp-api
# sets it itself from its own embedded server - only needed if you run `uvicorn ajp.api.app:app` directly.
DATABASE_URL=
AJP_DSN=

# ---------------------------------------------------------------- data locations ---------------------------
# Where ajp-init/ajp-run put the embedded Postgres data dir + raw store; defaults to ~/.ajp.
AJP_DATA_DIR=
# Where the raw HTTP envelope store (ajp.rawstore) lives, independent of AJP_DATA_DIR, for tools/scripts
# that construct their own LocalFsStore directly (tools/dev_up.py, ajp.fx.job) - defaults to ./data/raw.
RAW_STORE_ROOT=
# Where uploaded thesis documents + their reports are kept (ajp.thesis.store) - defaults to ./data/thesis.
THESIS_STORE_ROOT=

# ---------------------------------------------------------------- thesis similarity sources (all optional) --
# Every one of these sources degrades to "not consulted" (never fabricated, never silently pretended-absent
# - the similarity report says which sources ran) when its own key is unset. None are required for the
# thesis FORMATTING checks (ajp.thesis.checks) to work - only the similarity ESTIMATE's own extra sources.
CORE_API_KEY=
S2_API_KEY=
COPLEAKS_EMAIL=
COPLEAKS_API_KEY=
COPLEAKS_WEBHOOK_BASE_URL=

# ---------------------------------------------------------------- pending operator actions (no key exists yet) ----
# Jobbnorge (jobbnorge.no) and NBS (Serbia's official RSD middle rate) both need real credentials that have
# not been obtained yet (see pm/outbox/operator_actions.md) - neither has a concrete env var name in the
# code today (D6: not listed here as a fake key that would silently do nothing if set). Jobbnorge stays a
# deeplink-only channel and NBS's own fx rate stays absent (open.er-api.com is the RSD fallback, ajp.fx.erapi)
# until that operator action is done and the corresponding code is written.

# ---------------------------------------------------------------- API inbound controls (T49, 2026-10-13) ---
# These bound the PUBLIC self-service write endpoints (/v1/applicants, /v1/thesis) and gate the ADMIN
# write endpoints (the classification-review decision). They matter the moment the API is reachable from
# anywhere other than 127.0.0.1; with everything unset the behaviour is exactly the pre-T49 one.
#
# Rate limiting is per-client in-process (no Redis, no shared store): correct for the single-process
# deployment this project runs. A multi-worker deployment would need a shared store - if you ever run
# uvicorn with --workers > 1, each worker gets its own budget and the real limit becomes N x these.
# AJP_RATE_LIMIT_UPLOAD_PER_HOUR   POST /v1/applicants, POST /v1/thesis/analyze   (default 60)
# AJP_RATE_LIMIT_COMPUTE_PER_HOUR  POST .../matches, POST .../similarity          (default 240)
# AJP_RATE_LIMIT_WRITE_PER_HOUR    PATCH/DELETE                                   (default 240)
AJP_RATE_LIMIT_UPLOAD_PER_HOUR=
AJP_RATE_LIMIT_COMPUTE_PER_HOUR=
AJP_RATE_LIMIT_WRITE_PER_HOUR=
# Set to 1 ONLY behind a reverse proxy that sets X-Forwarded-For (Caddy/nginx). Default off: without a
# proxy, trusting that header lets a client mint unlimited rate-limit buckets with a fake header; with a
# proxy, NOT trusting it puts every visitor in the proxy's one shared bucket and locks the site out.
AJP_TRUST_PROXY_HEADERS=

# Admin endpoints (POST /v1/classification-review/{id}/decision). Refuse-when-unconfigured: with this
# empty, those endpoints return 503 and are OFF rather than open. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AJP_ADMIN_TOKEN=
